# --------------------------------------------------
# Groq Cloud API Configuration (Required)
# --------------------------------------------------
# Obtain from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional: Backup key for automatic 429 rate-limit rotation
GROQ_API_KEY_BACKUP=gsk_your_backup_groq_api_key_here

# Groq Model IDs
GROQ_MODEL=openai/gpt-oss-120b
GROQ_ROUTER_MODEL=openai/gpt-oss-120b
GROQ_MAX_TOKENS=2048

# --------------------------------------------------
# Vercel Deployment Configuration (Optional)
# --------------------------------------------------
# If connecting the Vercel frontend to a dedicated backend container (Render/Railway):
# BACKEND_URL=https://your-backend-app.onrender.com
